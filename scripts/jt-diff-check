#!/usr/bin/env python3
"""Fail when a code card's review section does not match the commit range."""

from __future__ import annotations

import importlib.util
import sys
from pathlib import Path

_GATE = Path(__file__).resolve().parents[1] / "skills" / "jt-next-step" / "gate.py"


def _load():
    spec = importlib.util.spec_from_file_location("jt_diff_gate", _GATE)
    if spec is None or spec.loader is None:
        raise RuntimeError("gate missing")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def main(argv: list[str] | None = None) -> int:
    gate = _load()
    return gate.diff_check_main(sys.argv[1:] if argv is None else argv)


if __name__ == "__main__":
    sys.exit(main())
